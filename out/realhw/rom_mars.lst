(1) 3734/    1152 : 77                  		ld	(hl),a
(1) 3735/    1153 : 0F                  		rrca
(1) 3736/    1154 : 77                  		ld	(hl),a
(1) 3737/    1155 : 0F                  		rrca
(1) 3738/    1156 : 77                  		ld	(hl),a
