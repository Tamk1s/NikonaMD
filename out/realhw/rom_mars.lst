(1)    7/   2E440 :                     ; Usage:
(1)    8/   2E440 :                     ;	data_bank LABEL_START
(1)    9/   2E440 :                     ;	include "game/data/your_bank.asm"
(1)   10/   2E440 :                     ;	dend_bank LABEL_END
(1)   11/   2E440 :                     ;
(1)   12/   2E440 :                     ; CD/CD32X ONLY:
(1)   13/   2E440 :                     ; Go to incl_list.asm add an entry in disc_banklist:
(1)   14/   2E440 :                     ; 	dc.l DATA_BANK			; Label
(1)   15/   2E440 :                     ; 	dc.b "BNK_EXMP.BIN"		; ISO filename
(1)   16/   2E440 :                     ;
(1)   17/   2E440 :                     ; And add the labels and ISO filename at iso_files.asm
(1)   18/   2E440 :                     ;
(1)   19/   2E440 :                     ; * This is ONLY required for CD/CD32X, if you forget to
(1)   20/   2E440 :                     ; include it it will crash the entire system.
(1)   21/   2E440 :                     ;
(1)   22/   2E440 :                     ; During your screen code load banks with:
(1)   23/   2E440 :                     ; 	move.l	#DATA_BANK,d0
(1)   24/   2E440 :                     ; 	bsr	System_SetDataBank
(1)   25/   2E440 :                     ;
(1)   26/   2E440 :                     ; You MUST use the banks for compatibility to all systems
(1)   27/   2E440 :                     ; even if the standard Genesis doesn't require it.
(1)   28/   2E440 :                     ; DO note that on SCD and CD32X the DATA banks are stored
(1)   29/   2E440 :                     ; on DISC so loading banks will be SLOW.
(1)   30/   2E440 :                     ; ------------------------------------------------------------
(1)   31/   2E440 :                     
(1)   32/   2E440 : (MACRO)              	data_bank DATA_BANK0
(1)   32/   2E440 :                                     align 4                 ; 32X alignment
(1)   32/   2E440 : =$2E440              DATA_BANK0 label *                        ; Register label
(1)   32/  92E440 :                                     phase $900000+(DATA_BANK0&$0FFFFF)
(1)   32/  92E440 : =$92E440             GLBL_MDATA_ST := *                      ; Save current pos globally
(1)   33/  92E440 :                     	include "game/data/bank_main.asm"
