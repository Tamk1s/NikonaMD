(1) 3752/    1165 : CF                  		rst	8
(1) 3753/    1166 :                     	; Transfer ROM data in packets
(1) 3754/    1166 :                     	; while playing the cache'd sample
(1) 3755/    1166 :                     	; *** CRITICAL PROCESS ***
(1) 3756/    1166 :                     	;
(1) 3757/    1166 :                     	; pseudo-ref for ldir:
(1) 3758/    1166 :                     	; ld (de),(hl)	; load memory (hl) to (de)
(1) 3759/    1166 :                     	; inc de	; incr de + 1
(1) 3760/    1166 :                     	; inc hl	; incr hl + 1
(1) 3761/    1166 :                     	; dec bc	; decr bc - 1
(1) 3762/    1166 : 06 00               		ld	b,0
(1) 3763/    1168 : 79                  		ld	a,c		; a - Size counter
(1) 3764/    1169 : D6 09               		sub	MAX_TRFRPZ	; Length lower than MAX_TRFRPZ?
(1) 3765/    116B : 38 14               		jr	c,.x68klast	; Process single piece only
(1) 3766/    116D :                     .x68kloop:
(1) 3767/    116D : CF                  		rst	8
(1) 3768/    116E : 00                  		nop
(1) 3769/    116F : 0E 08               		ld	c,MAX_TRFRPZ-1
(1) 3770/    1171 : DD CB 00 46         		bit	0,(ix)		; Genesis blocks ROM?
(1) 3771/    1175 : C4 8F 11            		call	nz,.x68klpwt
(1) 3772/    1178 : ED B0               		ldir			; (de) to (hl) until bc == 0
(1) 3773/    117A : CF                  		rst	8
(1) 3774/    117B : 00                  		nop
(1) 3775/    117C : D6 08               		sub	a,MAX_TRFRPZ-1
(1) 3776/    117E : D2 6D 11            		jp	nc,.x68kloop
(1) 3777/    1181 :                     ; last block
(1) 3778/    1181 :                     .x68klast:
(1) 3779/    1181 : C6 09               		add	a,MAX_TRFRPZ
(1) 3780/    1183 : 4F                  		ld	c,a
(1) 3781/    1184 : DD CB 00 46         		bit	0,(ix)		; Genesis blocks ROM?
(1) 3782/    1188 : C4 8F 11            		call	nz,.x68klpwt
(1) 3783/    118B : ED B0               		ldir
(1) 3784/    118D : CF                  		rst	8
(1) 3785/    118E : C9                  		ret
(1) 3786/    118F :                     
(1) 3787/    118F :                     ; Wait here until Genesis unlocks ROM
(1) 3788/    118F :                     .x68klpwt:
(1) 3789/    118F : 00                  		nop
(1) 3790/    1190 : CF                  		rst	8
(1) 3791/    1191 : DD CB 00 46         		bit	0,(ix)		; 68k finished?
(1) 3792/    1195 : 20 F8               		jr	nz,.x68klpwt
(1) 3793/    1197 : C9                  		ret
