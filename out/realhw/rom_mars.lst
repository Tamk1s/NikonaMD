(1)  247/FFFFFFFFFFFF19FE :                     ; ====================================================================
(1)  248/FFFFFFFFFFFF19FE :                     ; --------------------------------------------------------
(1)  249/FFFFFFFFFFFF19FE :                     ; System_Render
(1)  250/FFFFFFFFFFFF19FE :                     ;
(1)  251/FFFFFFFFFFFF19FE :                     ; This will:
(1)  252/FFFFFFFFFFFF19FE :                     ; - Drop a frame if we got late on VBlank
(1)  253/FFFFFFFFFFFF19FE :                     ; - Process Palette fading buffers
(1)  254/FFFFFFFFFFFF19FE :                     ;   (Video_MdMars_RunFade: CPU-INTENSIVE IF PROCESSING
(1)  255/FFFFFFFFFFFF19FE :                     ;   BOTH VDP AND 32X SVDP Palettes)
(1)  256/FFFFFFFFFFFF19FE :                     ; - Check the sound driver for any changes/requests
(1)  257/FFFFFFFFFFFF19FE :                     ;   from Z80 (Sound_Update, several times)
(1)  258/FFFFFFFFFFFF19FE :                     ; - 32X/CD32X only: Update the "DREQ RAM" section
(1)  259/FFFFFFFFFFFF19FE :                     ;   to the SH2 using DREQ FIFO (System_MdMars_Update)
(1)  260/FFFFFFFFFFFF19FE :                     ;
(1)  261/FFFFFFFFFFFF19FE :                     ; Then during VBlank:
(1)  262/FFFFFFFFFFFF19FE :                     ; - Read the Input data (System_Input)
(1)  263/FFFFFFFFFFFF19FE :                     ; - Transfer the VDP Palette, Sprites and Scroll
(1)  264/FFFFFFFFFFFF19FE :                     ;   from from RAM to VDP and process the DMA BLAST list.
(1)  265/FFFFFFFFFFFF19FE :                     ;   (Video_Render)
(1)  266/FFFFFFFFFFFF19FE :                     ;
(1)  267/FFFFFFFFFFFF19FE :                     ; Notes:
(1)  268/FFFFFFFFFFFF19FE :                     ; - This exits INSIDE VBlank
(1)  269/FFFFFFFFFFFF19FE :                     ; - If VDP Display is disabled all of this
(1)  270/FFFFFFFFFFFF19FE :                     ;   will be skipped.
(1)  271/FFFFFFFFFFFF19FE :                     ; --------------------------------------------------------
(1)  272/FFFFFFFFFFFF19FE :                     
(1)  273/FFFFFFFFFFFF19FE :                     System_Render:
(1)  274/FFFFFFFFFFFF19FE : 3E38 F556           		move.w	(RAM_VdpRegSet1).w,d7
(1)  275/FFFFFFFFFFFF1A02 : 0807 0006           		btst	#bitDispEnbl,d7
(1)  276/FFFFFFFFFFFF1A06 : 6774                		beq	.forgot_disp
(1)  277/FFFFFFFFFFFF1A08 : 6100 F2C8           		bsr	Video_RunFade			; Process VDP palette fade
