(1)   30/       0 :                     ; seq_Status: %ERP- V--0
(1)   31/       0 :                     ; E - enabled
(1)   32/       0 :                     ; R - Init|Restart track
(1)   33/       0 :                     ; P - refill-on-playback
(1)   34/       0 :                     ; V - volume change flag
(1)   35/       0 :                     ; 0 - Use global sub-beats
(1)   36/       0 : =0H                  seq_Status	equ 00h	; ** Slot Status and flags (MUST BE at 00h)
(1)   37/       0 : =1H                  seq_Num		equ 01h ; ** Sequence number
