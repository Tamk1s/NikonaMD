(1) 3740/    1158 : 77                  		ld	(hl),a
(1) 3741/    1159 : 0F                  		rrca
(1) 3742/    115A : CF                  		rst	8
(1) 3743/    115B : 77                  		ld	(hl),a
(1) 3744/    115C : 0F                  		rrca
(1) 3745/    115D : 77                  		ld	(hl),a
(1) 3746/    115E : 0F                  		rrca
(1) 3747/    115F : 77                  		ld	(hl),a
(1) 3748/    1160 : 0F                  		rrca
