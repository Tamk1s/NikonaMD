(1) 3628/    10E1 :                     ; readRom
(1) 3629/    10E1 :                     ;
(1) 3630/    10E1 :                     ; Transfer bytes from ROM to Z80 RAM.
(1) 3631/    10E1 :                     ; This also tells to 68k that we want to access ROM
(1) 3632/    10E1 :                     ;
(1) 3633/    10E1 :                     ; Input:
(1) 3634/    10E1 :                     ; a  | 68K Address $xx0000
(1) 3635/    10E1 :                     ;  c | Byte count (size 0 NOT allowed, MAX: 0FFh)
(1) 3636/    10E1 :                     ; hl | 68K Address $00xxxx
(1) 3637/    10E1 :                     ; de | Destination pointer
(1) 3638/    10E1 :                     ;
(1) 3639/    10E1 :                     ; Uses:
(1) 3640/    10E1 :                     ; b
(1) 3641/    10E1 :                     ;
(1) 3642/    10E1 :                     ; Notes:
(1) 3643/    10E1 :                     ; call RST 20h first, so the currenty playing DAC
(1) 3644/    10E1 :                     ; sample has enough data before getting busy here.
(1) 3645/    10E1 :                     ; --------------------------------------------------------
(1) 3646/    10E1 :                     
(1) 3647/    10E1 :                     readRom:
(1) 3648/    10E1 : DD E5               		push	ix
(1) 3649/    10E3 : DD 21 81 1F         		ld	ix,commZRomBlk		; ix - rom read/block flags
(1) 3650/    10E7 : FE FF               		cp	0FFh			; Reading from 68k's RAM?
(1) 3651/    10E9 : 28 3D               		jr	z,.from_ram
(1) 3652/    10EB : CF                  		rst	8
(1) 3653/    10EC : 22 35 00            		ld	(x68ksrclsb),hl		; Backup midlow address
(1) 3654/    10EF : CB BC               		res	7,h			; Reset MSB bit 7
(1) 3655/    10F1 : 06 00               		ld	b,0			; Clear b
(1) 3656/    10F3 : 0B                  		dec	bc			; len-1
(1) 3657/    10F4 : 09                  		add	hl,bc			; Add len to the mid and low to this temp address
(1) 3658/    10F5 : CB 7C               		bit	7,h			; Did it cross the bank?
(1) 3659/    10F7 : 20 0B               		jr	nz,.double		; Then it's a double transfer
(1) 3660/    10F9 : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore hl
(1) 3661/    10FC : 0C                  		inc	c			; len+1
(1) 3662/    10FD : 47                  		ld	b,a			; b - $xx0000
(1) 3663/    10FE : CD 48 11            		call	.transfer
(1) 3664/    1101 : DD E1               		pop	ix
(1) 3665/    1103 : C9                  		ret
(1) 3666/    1104 :                     .double:
(1) 3667/    1104 : CF                  		rst	8
(1) 3668/    1105 : 47                  		ld	b,a			; b - $xx0000
(1) 3669/    1106 : C5                  		push	bc			; Backup len and midlow address
(1) 3670/    1107 : E5                  		push	hl
(1) 3671/    1108 : 79                  		ld	a,c			; len - LSB
(1) 3672/    1109 : 95                  		sub	a,l
(1) 3673/    110A : 4F                  		ld	c,a			; Save new size
(1) 3674/    110B : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore TOP
(1) 3675/    110E : CD 48 11            		call	.transfer
(1) 3676/    1111 : E1                  		pop	hl			; Restore len and midlow address
(1) 3677/    1112 : C1                  		pop	bc
(1) 3678/    1113 : 4D                  		ld	c,l			; Get second len
(1) 3679/    1114 : 0C                  		inc	c
(1) 3680/    1115 : 3A 36 00            		ld	a,(x68ksrcmid)
(1) 3681/    1118 : E6 80               		and	80h
(1) 3682/    111A : C6 80               		add	a,80h
(1) 3683/    111C : 67                  		ld	h,a
(1) 3684/    111D : 2E 00               		ld	l,0
(1) 3685/    111F : 30 01               		jr	nc,.x68knocarry
(1) 3686/    1121 : 04                  		inc	b			; Next $xx0000
(1) 3687/    1122 :                     .x68knocarry:
(1) 3688/    1122 : CD 48 11            		call	.transfer
(1) 3689/    1125 : DD E1               		pop	ix
(1) 3690/    1127 : C9                  		ret
