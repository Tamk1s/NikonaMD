(1)  231/FFFFFFFFFFFF0000 :                     ; !@ gInsPco - Pico ADPCM instrument
(1)  232/FFFFFFFFFFFF0000 :                     ;
(1)  233/FFFFFFFFFFFF0000 :                     ; pitch | Pitch/Octave
(1)  234/FFFFFFFFFFFF0000 :                     ; start | 24-bit pointer
(1)  235/FFFFFFFFFFFF0000 :                     ; flags | Flags: %0000fffl
(1)  236/FFFFFFFFFFFF0000 :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  237/FFFFFFFFFFFF0000 :                     ;         | f - ADPCM filter bit select: 
(1)  238/FFFFFFFFFFFF0000 :                     ;				00 = ??
(1)  239/FFFFFFFFFFFF0000 :                     ;				01 = 6 kHz, 
(1)  240/FFFFFFFFFFFF0000 :                     ;				10 = 12 kHz,
(1)  241/FFFFFFFFFFFF0000 :                     ;				11 = 16 kHz, 
(1)  242/FFFFFFFFFFFF0000 :                     ; volume | volume: %00000vvv
(1)  243/FFFFFFFFFFFF0000 :                     ;         | v - Volume strength
(1)  244/FFFFFFFFFFFF0000 :                     ; ----------------------------------------------------
(1)  245/FFFFFFFFFFFF0000 :                     gInsPco	macro pitch,start,flags,volume
(1)  246/FFFFFFFFFFFF0000 :                      if PICO == 1
(1)  247/FFFFFFFFFFFF0000 :                     	dc.b $F0|flags,pitch,((start>>16)&$FF),((start>>8)&$FF)
(1)  248/FFFFFFFFFFFF0000 :                     	dc.b start&$FF,volume,0,0
(1)  249/FFFFFFFFFFFF0000 :                      else
(1)  250/FFFFFFFFFFFF0000 :                      	dc.b $00,$00,$00,$00
(1)  251/FFFFFFFFFFFF0000 :                     	dc.b $00,$00,$00,$00
(1)  252/FFFFFFFFFFFF0000 :                      endif
(1)  253/FFFFFFFFFFFF0000 :                     	endm
