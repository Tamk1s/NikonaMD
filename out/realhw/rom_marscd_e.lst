(1) 3628/    11FA :                     ; readRom
(1) 3629/    11FA :                     ;
(1) 3630/    11FA :                     ; Transfer bytes from ROM to Z80 RAM.
(1) 3631/    11FA :                     ; This also tells to 68k that we want to access ROM
(1) 3632/    11FA :                     ;
(1) 3633/    11FA :                     ; Input:
(1) 3634/    11FA :                     ; a  | 68K Address $xx0000
(1) 3635/    11FA :                     ;  c | Byte count (size 0 NOT allowed, MAX: 0FFh)
(1) 3636/    11FA :                     ; hl | 68K Address $00xxxx
(1) 3637/    11FA :                     ; de | Destination pointer
(1) 3638/    11FA :                     ;
(1) 3639/    11FA :                     ; Uses:
(1) 3640/    11FA :                     ; b
(1) 3641/    11FA :                     ;
(1) 3642/    11FA :                     ; Notes:
(1) 3643/    11FA :                     ; call RST 20h first, so the currenty playing DAC
(1) 3644/    11FA :                     ; sample has enough data before getting busy here.
(1) 3645/    11FA :                     ; --------------------------------------------------------
(1) 3646/    11FA :                     
(1) 3647/    11FA :                     readRom:
