(1)   94/FFFFFFFFFFFF0000 :                     ;
(1)   95/FFFFFFFFFFFF0000 :                     ; Note:
(1)   96/FFFFFFFFFFFF0000 :                     ; UNUSED instruments MUST use gInsNull or
