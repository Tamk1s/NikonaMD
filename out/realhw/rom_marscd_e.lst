(1)    7/   38800 :                     ; Usage:
(1)    8/   38800 :                     ;	data_bank LABEL_START
(1)    9/   38800 :                     ;	include "game/data/your_bank.asm"
(1)   10/   38800 :                     ;	dend_bank LABEL_END
(1)   11/   38800 :                     ;
(1)   12/   38800 :                     ; CD/CD32X ONLY:
(1)   13/   38800 :                     ; Go to incl_list.asm add an entry in disc_banklist:
(1)   14/   38800 :                     ; 	dc.l DATA_BANK			; Label
(1)   15/   38800 :                     ; 	dc.b "BNK_EXMP.BIN"		; ISO filename
(1)   16/   38800 :                     ;
(1)   17/   38800 :                     ; And add the labels and ISO filename at iso_files.asm
(1)   18/   38800 :                     ;
(1)   19/   38800 :                     ; * This is ONLY required for CD/CD32X, if you forget to
(1)   20/   38800 :                     ; include it it will crash the entire system.
(1)   21/   38800 :                     ;
(1)   22/   38800 :                     ; During your screen code load banks with:
(1)   23/   38800 :                     ; 	move.l	#DATA_BANK,d0
(1)   24/   38800 :                     ; 	bsr	System_SetDataBank
(1)   25/   38800 :                     ;
(1)   26/   38800 :                     ; You MUST use the banks for compatibility to all systems
(1)   27/   38800 :                     ; even if the standard Genesis doesn't require it.
(1)   28/   38800 :                     ; DO note that on SCD and CD32X the DATA banks are stored
(1)   29/   38800 :                     ; on DISC so loading banks will be SLOW.
(1)   30/   38800 :                     ; ------------------------------------------------------------
(1)   31/   38800 :                     
(1)   32/   38800 : (MACRO)              	data_bank DATA_BANK0
(1)   32/   38800 :                                     align $800              ; Sector alignment
(1)   32/   38800 : =$38800              DATA_BANK0 label *                        ; Register label
(1)   32/  200000 :                                     phase sysmcd_wram
(1)   32/  200000 : =$200000             GLBL_MDATA_ST := *                      ; Save current pos globally
(1)   33/  200000 :                     	include "game/data/bank_main.asm"
