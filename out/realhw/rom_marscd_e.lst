(1) 3671/    1221 : 79                  		ld	a,c			; len - LSB
(1) 3672/    1222 : 95                  		sub	a,l
(1) 3673/    1223 : 4F                  		ld	c,a			; Save new size
(1) 3674/    1224 : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore TOP
(1) 3675/    1227 : CD 61 12            		call	.transfer
(1) 3676/    122A : E1                  		pop	hl			; Restore len and midlow address
(1) 3677/    122B : C1                  		pop	bc
(1) 3678/    122C : 4D                  		ld	c,l			; Get second len
(1) 3679/    122D : 0C                  		inc	c
(1) 3680/    122E : 3A 36 00            		ld	a,(x68ksrcmid)
(1) 3681/    1231 : E6 80               		and	80h
