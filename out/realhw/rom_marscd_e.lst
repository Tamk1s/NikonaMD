     185/FFFFFFFFFFFF2B7A :                     ; SCREEN MODE MAIN LOOP
     186/FFFFFFFFFFFF2B7A :                     ;
     187/FFFFFFFFFFFF2B7A :                     ;  MD/Pico: Direct ROM jump
     188/FFFFFFFFFFFF2B7A :                     ; CD/CD32X: Reads file from DISC and
     189/FFFFFFFFFFFF2B7A :                     ;           transfers code to RAM
     190/FFFFFFFFFFFF2B7A :                     ;      32X: Code is stored on ROM but runs in
     191/FFFFFFFFFFFF2B7A :                     ;           RAM to prevent conflicts with the
     192/FFFFFFFFFFFF2B7A :                     ;           SH2
     193/FFFFFFFFFFFF2B7A :                     ;
     194/FFFFFFFFFFFF2B7A :                     ; - Returning(rts) in your current screen code return
     195/FFFFFFFFFFFF2B7A :                     ;   here
     196/FFFFFFFFFFFF2B7A :                     ; - CD/32X/CD32X:
     197/FFFFFFFFFFFF2B7A :                     ;   This will turn OFF ALL special features
     198/FFFFFFFFFFFF2B7A :                     ; --------------------------------------------------------
     199/FFFFFFFFFFFF2B7A :                     
     200/FFFFFFFFFFFF2B7A :                     Md_ReadModes:
     201/FFFFFFFFFFFF2B7A : 007C 0700           		ori.w	#$0700,sr			; Disable interrupts
     203/FFFFFFFFFFFF2B7E : 6100 EC5A           		bsr	Video_MdMcd_StampDisable	; Disable Stamps
     204/FFFFFFFFFFFF2B82 : 6100 FBC6           		bsr	System_MdMcd_CddaStop		; Stop CDDA
     207/FFFFFFFFFFFF2B86 : 6100 EE6A           		bsr	Video_MdMars_VideoOff		; Turn OFF all 32X visuals
     209/FFFFFFFFFFFF2B8A : 7000                		moveq	#0,d0
