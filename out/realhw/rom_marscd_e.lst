(1) 3653/    1205 : 22 35 00            		ld	(x68ksrclsb),hl		; Backup midlow address
(1) 3654/    1208 : CB BC               		res	7,h			; Reset MSB bit 7
(1) 3655/    120A : 06 00               		ld	b,0			; Clear b
(1) 3656/    120C : 0B                  		dec	bc			; len-1
(1) 3657/    120D : 09                  		add	hl,bc			; Add len to the mid and low to this temp address
(1) 3658/    120E : CB 7C               		bit	7,h			; Did it cross the bank?
(1) 3659/    1210 : 20 0B               		jr	nz,.double		; Then it's a double transfer
(1) 3660/    1212 : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore hl
(1) 3661/    1215 : 0C                  		inc	c			; len+1
(1) 3662/    1216 : 47                  		ld	b,a			; b - $xx0000
(1) 3663/    1217 : CD 61 12            		call	.transfer
