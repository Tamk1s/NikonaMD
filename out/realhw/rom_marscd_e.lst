(1) 3754/    127F :                     	; while playing the cache'd sample
(1) 3755/    127F :                     	; *** CRITICAL PROCESS ***
(1) 3756/    127F :                     	;
(1) 3757/    127F :                     	; pseudo-ref for ldir:
(1) 3758/    127F :                     	; ld (de),(hl)	; load memory (hl) to (de)
(1) 3759/    127F :                     	; inc de	; incr de + 1
(1) 3760/    127F :                     	; inc hl	; incr hl + 1
(1) 3761/    127F :                     	; dec bc	; decr bc - 1
