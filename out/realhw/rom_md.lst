(1)   20/     2A2 :                     	endif
(1)   21/     2A2 :                     labl	label *
(1)   22/     2A2 :                     	dc.b ((labl_e-labl_s)&$FF),(((labl_e-labl_s)>>8)&$FF),(((labl_e-labl_s)>>16)&$FF)	; dc.b 1,2,3 Length
