(1)   56/     2A2 :                     ; gemaTrk - Sequence entry in the current master
(1)   57/     2A2 :                     ;           list
(1)   58/     2A2 :                     ;
(1)   59/     2A2 :                     ; enblt | Disable/Enable global beats on this Sequence:
(1)   60/     2A2 :                     ;         0 - Don't use beats
(1)   61/     2A2 :                     ;         1 - Use beats
(1)   62/     2A2 :                     ; ticks | Ticks (Default tempo: 150-NTSC 120-PAL)
(1)   63/     2A2 :                     ;   loc | Direct 24-bit location of the sequence data
(1)   64/     2A2 :                     ; ----------------------------------------------------
(1)   65/     2A2 :                     
(1)   66/     2A2 :                     gemaTrk macro enblt,ticks,loc
(1)   67/     2A2 :                     	dc.l ((enblt&$01)<<31)|((ticks&$7F)<<24)|(loc&$FFFFFF)
(1)   68/     2A2 :                     	endm
(1)   69/     2A2 :                     
(1)   70/     2A2 :                     ; ----------------------------------------------------
(1)   71/     2A2 :                     ; gemaHead - Sequence data header
(1)   72/     2A2 :                     ;
(1)   73/     2A2 :                     ; blk_data  | Block data pointer
(1)   74/     2A2 :                     ; patt_data | Pattern data pointer
(1)   75/     2A2 :                     ; ins_list  | instrument list pointer
(1)   76/     2A2 :                     ; num_chnls | Number of channels used in the seq
(1)   77/     2A2 :                     ;             If 0: Read ALL channels
(1)   78/     2A2 :                     ;                   (NOT recommended, UNSTABLE)
(1)   79/     2A2 :                     ;
(1)   80/     2A2 :                     ; Note:
(1)   81/     2A2 :                     ; Pointers are in 68k map area
(1)   82/     2A2 :                     ; ----------------------------------------------------
(1)   83/     2A2 :                     
(1)   84/     2A2 :                     gemaHead macro blk,pat,ins,num
(1)   85/     2A2 :                     	dc.w num
(1)   86/     2A2 :                     	dc.l blk
(1)   87/     2A2 :                     	dc.l pat
(1)   88/     2A2 :                     	dc.l ins
(1)   89/     2A2 :                     	endm
(1)   90/     2A2 :                     
(1)   91/     2A2 :                     ; ------------------------------------------------------------
(1)   92/     2A2 :                     ; Instrument macros, instrument_num-1
