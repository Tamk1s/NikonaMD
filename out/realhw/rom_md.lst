(1)  135/       0 :                     ; --------------------------------------------------------
(1)  136/       0 :                     ; Code starts here
(1)  137/       0 :                     ; --------------------------------------------------------
(1)  138/       0 :                     
(1)  139/       0 : F3                  		di			; Disable interrupts
(1)  140/       1 : ED 56               		im	1		; Interrupt mode 1
(1)  141/       3 : 31 00 20            		ld	sp,2000h	; Set STACK at the end of Z80
(1)  142/       6 : 18 36               		jr	z80_init	; Jump to z80_init
(1)  143/       8 :                     
(1)  144/       8 :                     ; --------------------------------------------------------
(1)  145/       8 :                     ; RST 8 (dac_me)
(1)  146/       8 :                     ;
(1)  147/       8 :                     ; Writes wave data to DAC using data stored
(1)  148/       8 :                     ; on the wave buffer, call this routine every 6 or 8
(1)  149/       8 :                     ; instructions to keep the samplerate stable.
(1)  150/       8 :                     ;
(1)  151/       8 :                     ; Input (EXX):
(1)  152/       8 :                     ;  c - WAVE buffer MSB
(1)  153/       8 :                     ; de - Pitch (xx.00)
(1)  154/       8 :                     ; h  - WAVE buffer LSB (as xx.00)
(1)  155/       8 :                     ;
(1)  156/       8 :                     ; Uses (EXX):
(1)  157/       8 :                     ; b
(1)  158/       8 :                     ;
(1)  159/       8 :                     ; Notes:
(1)  160/       8 :                     ; ONLY USE dac_on and dac_off to turn OFF/ON
(1)  161/       8 :                     ; DAC playback
(1)  162/       8 :                     ;
(1)  163/       8 :                     ; Samplerate is 16000hz with minimal quality loss.
(1)  164/       8 :                     ; --------------------------------------------------------
(1)  165/       8 :                     
(1)  166/       8 :                     ; EXX set:
(1)  167/       8 :                     ; af - temporal
(1)  168/       8 :                     ; bc - l temporal | dWaveBuff MSB
(1)  169/       8 :                     ; de - pitch increment
(1)  170/       8 :                     ; hl - wave buffer position 00.00h
(1)  171/       8 :                     		org 8
(1)  172/       8 : D9                  dac_me:		exx			; * flip registers | Changes between EXX(play) and RET(stop)
(1)  173/       9 : 08                  		ex	af,af'		; Swap af
(1)  174/       A : 45                  		ld	b,l		; Save old hl buff
(1)  175/       B : 6C                  		ld	l,h		;
(1)  176/       C : 61                  		ld	h,c		; h - Set buffer MSB
(1)  177/       D : 3E 2A               		ld	a,2Ah		;
(1)  178/       F : 32 00 40            		ld	(Zym_ctrl_1),a	; Set YM Register 2Ah
(1)  179/      12 : 7E                  		ld	a,(hl)		; Read wave byte and
(1)  180/      13 : 32 01 40            		ld	(Zym_data_1),a	; write it to DAC
(1)  181/      16 : 65                  		ld	h,l		; Get hl buff back
(1)  182/      17 : 68                  		ld	l,b		;
(1)  183/      18 : 19                  		add	hl,de		; Pitch increment hl
(1)  184/      19 : 08                  		ex	af,af'		; Return af
(1)  185/      1A : D9                  		exx			; * return regs
(1)  186/      1B : C9                  		ret
(1)  187/      1C :                     
(1)  188/      1C :                     ; --------------------------------------------------------
(1)  189/      1C :                     ; 1Ch - Master tracklist pointer
(1)  190/      1C :                     gemaMstrListPos:
(1)  191/      1C : 00                  		db 0			; ** 32-bit 68k address **
(1)  192/      1D : 00                  		db 0
(1)  193/      1E : 00                  		db 0
(1)  194/      1F : 00                  		db 0
(1)  195/      20 :                     
(1)  196/      20 :                     ; --------------------------------------------------------
(1)  197/      20 :                     ; RST 20h (dac_me)
(1)  198/      20 :                     ; *** self-modifiable code ***
(1)  199/      20 :                     ;
(1)  200/      20 :                     ; Checks if the WAVE cache needs refilling to keep
(1)  201/      20 :                     ; it playing.
(1)  202/      20 :                     ; --------------------------------------------------------
(1)  203/      20 :                     
(1)  204/      20 :                     		org 20h
(1)  205/      20 : F5                  dac_fill:	push	af		; Save af | Changes between PUSH AF(play) and RET(stop)
(1)  206/      21 : 3A 37 00            		ld	a,(dDacFifoMid)	; a - Get half-way value
(1)  207/      24 : D9                  		exx			; * flip registers
(1)  208/      25 : AC                  		xor	h		; Grab LSB.00
(1)  209/      26 : D9                  		exx			; * restore regs
(1)  210/      27 : E6 80               		and	80h		; Check if LSB 7th bit changed
(1)  211/      29 : C4 56 12            		call	nz,dac_refill	; If yes, call refill and update LSB
(1)  212/      2C : F1                  		pop	af		; Restore af
(1)  213/      2D : C9                  		ret
(1)  214/      2E :                     
(1)  215/      2E :                     ; --------------------------------------------------------
(1)  216/      2E :                     ; 02Eh - User read/write values
(1)  217/      2E :                     
(1)  218/      2E : 00                  commZRead	db 0			; cmd fifo READ pointer (here)
(1)  219/      2F : 00                  psgHatMode	db 0			; Current PSGN mode
(1)  220/      30 : 00                  fmSpecial	db 0			; copy of FM3 enable bit
(1)  221/      31 : 00 00               sbeatAcc	dw 0			; Accumulates on each tick to trigger the sub beats
(1)  222/      33 : D6 00               sbeatPtck	dw 214			; Default global subbeats (this-32 for PAL) 214=125
(1)  223/      35 : 00                  x68ksrclsb	db 0			; readRom temporal LSB
(1)  224/      36 : 00                  x68ksrcmid	db 0			; readRom temporal MID
(1)  225/      37 : 00                  dDacFifoMid	db 0			; WAVE play halfway refill flag (00h/80h)
(1)  226/      38 :                     
(1)  227/      38 :                     ; --------------------------------------------------------
(1)  228/      38 :                     ; Z80 Interrupt at 0038h
(1)  229/      38 :                     ; --------------------------------------------------------
(1)  230/      38 :                     
(1)  231/      38 :                     		org 38h				; Align 38h
(1)  232/      38 : ED 73 0C 1C         		ld	(tickSpSet),sp		; Write TICK flag using current sp (read tickFlag only)
(1)  233/      3C : F3                  		di				; Disable interrupt
(1)  234/      3D : C9                  		ret
(1)  235/      3E :                     
(1)  236/      3E :                     ; --------------------------------------------------------
(1)  237/      3E :                     ; Initialize
(1)  238/      3E :                     ; --------------------------------------------------------
(1)  239/      3E :                     
(1)  240/      3E :                     z80_init:
(1)  241/      3E : CD 31 0F            		call	gema_init		; Init values
(1)  242/      41 :                     
(1)  243/      41 :                     ; --------------------------------------------------------
(1)  244/      41 :                     ; MAIN LOOP
(1)  245/      41 :                     ; --------------------------------------------------------
(1)  246/      41 :                     
(1)  247/      41 :                     drv_loop:
(1)  248/      41 : CF                  		rst	8
(1)  249/      42 : CD A3 0F            		call	get_tick		; Check tick on VBlank
