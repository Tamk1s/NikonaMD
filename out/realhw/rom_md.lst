(1)  408/     4E8 :                     ; gemaFadeSeq
(1)  409/     4E8 :                     ;
(1)  410/     4E8 :                     ; Set Master volume to a track slot.
(1)  411/     4E8 :                     ;
(1)  412/     4E8 :                     ; Input:
(1)  413/     4E8 :                     ; d0.b | Target volume
(1)  414/     4E8 :                     ; d1.b | Playback slot number
(1)  415/     4E8 :                     ;        If -1: Apply to all slots
(1)  416/     4E8 :                     ;
(1)  417/     4E8 :                     ; Notes:
(1)  418/     4E8 :                     ; - DO NOT MIX THIS WITH gemaSetTrackVol
(1)  419/     4E8 :                     ; - v1.0: This only works on (re)start
(1)  420/     4E8 :                     ;   or during new notes on playback.
(1)  421/     4E8 :                     ; --------------------------------------------------------
(1)  422/     4E8 :                     
(1)  423/     4E8 :                     gemaFadeSeq:
(1)  424/     4E8 : 6100 FEB0           		bsr	sndReq_Enter
