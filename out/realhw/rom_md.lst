     185/    201C :                     ; SCREEN MODE MAIN LOOP
     186/    201C :                     ;
     187/    201C :                     ;  MD/Pico: Direct ROM jump
     188/    201C :                     ; CD/CD32X: Reads file from DISC and
     189/    201C :                     ;           transfers code to RAM
     190/    201C :                     ;      32X: Code is stored on ROM but runs in
     191/    201C :                     ;           RAM to prevent conflicts with the
     192/    201C :                     ;           SH2
     193/    201C :                     ;
     194/    201C :                     ; - Returning(rts) in your current screen code return
     195/    201C :                     ;   here
     196/    201C :                     ; - CD/32X/CD32X:
     197/    201C :                     ;   This will turn OFF ALL special features
     198/    201C :                     ; --------------------------------------------------------
     199/    201C :                     
     200/    201C :                     Md_ReadModes:
     201/    201C : 007C 0700           		ori.w	#$0700,sr			; Disable interrupts
     209/    2020 : 7000                		moveq	#0,d0
     210/    2022 : 3038 F18A           		move.w	(RAM_ScreenMode).w,d0		; Read current screen number
     211/    2026 : C07C 007F           		and.w	#$7F,d0				; <-- CURRENT LIMIT
     212/    202A : E948                		lsl.w	#4,d0				; number * $10
     213/    202C : 41FB 000A           		lea	.screen_list(pc,d0.w),a0		; Read list
     214/    2030 :                     	; SCD/CD32X
     234/    2030 : 207B 0006           		movea.l	.screen_list(pc,d0.w),a0		; a0 - ROM location
     235/    2034 : 4E90                		jsr	(a0)
     237/    2036 : 60E4                		bra.s	Md_ReadModes			; Loop on rts
