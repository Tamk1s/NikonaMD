(1)   99/     2A2 :                     
(1)  100/     2A2 :                     ; ----------------------------------------------------
(1)  101/     2A2 :                     ; gInsNull - Null instrument
(1)  102/     2A2 :                     ;
(1)  103/     2A2 :                     ; You MUST use this on unused instruments.
(1)  104/     2A2 :                     ; ----------------------------------------------------
(1)  105/     2A2 :                     
(1)  106/     2A2 :                     gInsNull macro
(1)  107/     2A2 :                     	dc.b $00,$00,$00,$00
(1)  108/     2A2 :                     	dc.b $00,$00,$00,$00
(1)  109/     2A2 :                     	endm
(1)  110/     2A2 :                     
(1)  111/     2A2 :                     ; ----------------------------------------------------
(1)  112/     2A2 :                     ; gInsPsg - PSG tone
(1)  113/     2A2 :                     ;
(1)  114/     2A2 :                     ; pitch | Pitch/Octave
(1)  115/     2A2 :                     ; alv   | Attack level
(1)  116/     2A2 :                     ; atk   | Attack rate
(1)  117/     2A2 :                     ; slv   | Sustain
(1)  118/     2A2 :                     ; dky   | Decay rate (up)
(1)  119/     2A2 :                     ; rrt   | Release rate (down)
(1)  120/     2A2 :                     ; vib   | Set to 0, reserved for vibrato
(1)  121/     2A2 :                     ; ----------------------------------------------------
(1)  122/     2A2 :                     
(1)  123/     2A2 :                     gInsPsg	macro pitch,alv,atk,slv,dky,rrt,vib
(1)  124/     2A2 :                     	dc.b $80,pitch,alv,atk
(1)  125/     2A2 :                     	dc.b slv,dky,rrt,vib
(1)  126/     2A2 :                     	endm
(1)  127/     2A2 :                     
(1)  128/     2A2 :                     ; ----------------------------------------------------
(1)  129/     2A2 :                     ; gInsPsg - PSG noise
(1)  130/     2A2 :                     ;
(1)  131/     2A2 :                     ; pitch | Pitch/Octave
(1)  132/     2A2 :                     ; alv   | Attack level
(1)  133/     2A2 :                     ; atk   | Attack rate
(1)  134/     2A2 :                     ; slv   | Sustain
(1)  135/     2A2 :                     ; dky   | Decay rate (up)
(1)  136/     2A2 :                     ; rrt   | Release rate (down)
(1)  137/     2A2 :                     ; vib   | Set to 0, reserved for vibrato
(1)  138/     2A2 :                     ; mode  | Noise mode: %tmm
(1)  139/     2A2 :                     ;         t - Bass(0)|Noise(1)
(1)  140/     2A2 :                     ;         m - Clock(00)|Clock/2(01)|Clock/4(10)|Tone3(11)
(1)  141/     2A2 :                     ;
(1)  142/     2A2 :                     ; Note:
(1)  143/     2A2 :                     ; Using Tone3 will turn OFF channel 3.
(1)  144/     2A2 :                     ; ----------------------------------------------------
(1)  145/     2A2 :                     
(1)  146/     2A2 :                     gInsPsgN macro pitch,alv,atk,slv,dky,rrt,vib,mode
(1)  147/     2A2 :                     	dc.b $90|mode,pitch,alv,atk
(1)  148/     2A2 :                     	dc.b slv,dky,rrt,vib
(1)  149/     2A2 :                     	endm
(1)  150/     2A2 :                     
(1)  151/     2A2 :                     ; ----------------------------------------------------
(1)  152/     2A2 :                     ; gInsFm - YM2612 FM normal instrument/patch
(1)  153/     2A2 :                     ;
(1)  154/     2A2 :                     ; pitch | Pitch/Octave
(1)  155/     2A2 :                     ; fmins | 24-bit pointer to FM patch data
(1)  156/     2A2 :                     ; ----------------------------------------------------
(1)  157/     2A2 :                     
(1)  158/     2A2 :                     gInsFm macro pitch,fmins
(1)  159/     2A2 :                     	dc.b $A0,pitch,((fmins>>16)&$FF),((fmins>>8)&$FF)
(1)  160/     2A2 :                     	dc.b fmins&$FF,$00,$00,$00
(1)  161/     2A2 :                     	endm
(1)  162/     2A2 :                     
(1)  163/     2A2 :                     ; ----------------------------------------------------
(1)  164/     2A2 :                     ; gInsFm - YM2612 FM special instrument/patch
(1)  165/     2A2 :                     ;
(1)  166/     2A2 :                     ; pitch | UNUSED, value ignored (set to 0)
(1)  167/     2A2 :                     ; fmins | 24-bit pointer to FM patch data
(1)  168/     2A2 :                     ; ----------------------------------------------------
(1)  169/     2A2 :                     
(1)  170/     2A2 :                     gInsFm3	macro pitch,fmins
(1)  171/     2A2 :                     	dc.b $B0,pitch,((fmins>>16)&$FF),((fmins>>8)&$FF)
(1)  172/     2A2 :                     	dc.b fmins&$FF,$00,$00,$00
(1)  173/     2A2 :                     	endm
(1)  174/     2A2 :                     
(1)  175/     2A2 :                     ; ----------------------------------------------------
(1)  176/     2A2 :                     ; gInsDac - DAC instrument
(1)  177/     2A2 :                     ;
(1)  178/     2A2 :                     ; pitch | Pitch/Octave
(1)  179/     2A2 :                     ; start | 24-bit pointer
(1)  180/     2A2 :                     ; flags | Flags: %0000000l
(1)  181/     2A2 :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  182/     2A2 :                     ; ----------------------------------------------------
(1)  183/     2A2 :                     
(1)  184/     2A2 :                     gInsDac	macro pitch,start,flags
(1)  185/     2A2 :                     	dc.b $C0|flags,pitch,((start>>16)&$FF),((start>>8)&$FF)
(1)  186/     2A2 :                     	dc.b start&$FF,0,0,0
(1)  187/     2A2 :                     	endm
(1)  188/     2A2 :                     
(1)  189/     2A2 :                     ; ----------------------------------------------------
(1)  190/     2A2 :                     ; gInsPcm - RF5C164 PCM Sample (SEGA CD)
(1)  191/     2A2 :                     ;
(1)  192/     2A2 :                     ; pitch | Pitch/Octave
(1)  193/     2A2 :                     ; start | 24-bit direct pointer to
(1)  194/     2A2 :                     ;         Sub-CPU's memory area.
(1)  195/     2A2 :                     ; flags | Flags: %0000000l
(1)  196/     2A2 :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  197/     2A2 :                     ; ----------------------------------------------------
(1)  198/     2A2 :                     
(1)  199/     2A2 :                     gInsPcm	macro pitch,start,flags
(1)  200/     2A2 :                      if MCD|MARSCD
(1)  201/     2A2 :                     	dc.b $D0|flags,pitch,((start>>16)&$FF),((start>>8)&$FF)
(1)  202/     2A2 :                     	dc.b start&$FF,0,0,0
(1)  203/     2A2 :                      else
(1)  204/     2A2 :                     	dc.b $00,$00,$00,$00
(1)  205/     2A2 :                     	dc.b $00,$00,$00,$00
(1)  206/     2A2 :                      endif
(1)  207/     2A2 :                     	endm
(1)  208/     2A2 :                     
(1)  209/     2A2 :                     ; ----------------------------------------------------
(1)  210/     2A2 :                     ; gInsPwm - PWM Sample (SEGA 32X)
(1)  211/     2A2 :                     ;
(1)  212/     2A2 :                     ; pitch | Pitch/Octave
(1)  213/     2A2 :                     ; start | 32-bit pointer to
(1)  214/     2A2 :                     ;         SH2's map view: CS1(ROM) or CS3(SDRAM)
(1)  215/     2A2 :                     ; flags | Flags: %000000sl
(1)  216/     2A2 :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  217/     2A2 :                     ;         | s - Sample data is in Stereo: No(0)/Yes(1)
(1)  218/     2A2 :                     ; ----------------------------------------------------
(1)  219/     2A2 :                     
(1)  220/     2A2 :                     gInsPwm	macro pitch,start,flags
(1)  221/     2A2 :                      if MARS|MARSCD
(1)  222/     2A2 :                     	dc.b $E0|flags,pitch,((start>>24)&$FF),((start>>16)&$FF)
(1)  223/     2A2 :                     	dc.b ((start>>8)&$FF),start&$FF,0,0
(1)  224/     2A2 :                      else
(1)  225/     2A2 :                     	dc.b $00,$00,$00,$00
(1)  226/     2A2 :                     	dc.b $00,$00,$00,$00
(1)  227/     2A2 :                      endif
(1)  228/     2A2 :                     	endm
(1)  229/     2A2 :                     	
(1)  230/     2A2 :                     ; ----------------------------------------------------
(1)  231/     2A2 :                     ; !@ gInsPco - Pico ADPCM instrument
(1)  232/     2A2 :                     ;
(1)  233/     2A2 :                     ; pitch | Pitch/Octave
(1)  234/     2A2 :                     ; start | 24-bit pointer
(1)  235/     2A2 :                     ; flags | Flags: %0000fffl
(1)  236/     2A2 :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  237/     2A2 :                     ;         | f - ADPCM filter bit select: 
(1)  238/     2A2 :                     ;				00 = ??
(1)  239/     2A2 :                     ;				01 = 6 kHz, 
(1)  240/     2A2 :                     ;				10 = 12 kHz,
(1)  241/     2A2 :                     ;				11 = 16 kHz, 
(1)  242/     2A2 :                     ; volume | volume: %00000vvv
(1)  243/     2A2 :                     ;         | v - Volume strength
(1)  244/     2A2 :                     ; ----------------------------------------------------
(1)  245/     2A2 :                     gInsPco	macro pitch,start,flags,volume
(1)  246/     2A2 :                      if PICO == 1
(1)  247/     2A2 :                     	dc.b $F0|flags,pitch,((start>>16)&$FF),((start>>8)&$FF)
(1)  248/     2A2 :                     	dc.b start&$FF,volume,0,0
(1)  249/     2A2 :                      else
(1)  250/     2A2 :                      	dc.b $00,$00,$00,$00
(1)  251/     2A2 :                     	dc.b $00,$00,$00,$00
(1)  252/     2A2 :                      endif
(1)  253/     2A2 :                     	endm
     180/     2A2 :                     		include	"sound/drv/gema.asm"
(1)    1/     2A2 :                     ; ===========================================================================
