(1)    3/     2A2 :                     ; GEMA/Nikona Sound Driver v1.0
(1)    4/     2A2 :                     ; by GenesisFan64 2023-2024
(1)    5/     2A2 :                     ; -------------------------------------------------------------------
(1)    6/     2A2 :                     
(1)    7/     2A2 :                     ; ====================================================================
(1)    8/     2A2 :                     ; --------------------------------------------------------
(1)    9/     2A2 :                     ; Variables
(1)   10/     2A2 :                     ; --------------------------------------------------------
(1)   11/     2A2 :                     
(1)   12/     2A2 :                     ; z80_cpu	equ $A00000			; Z80 CPU area
(1)   13/     2A2 :                     ; z80_bus 	equ $A11100			; only read bit 0 (bit 8 as WORD)
(1)   14/     2A2 :                     ; z80_reset	equ $A11200			; WRITE only: $0000 reset/$0100 cancel
(1)   15/     2A2 : =$1F60               zDrvFifo	equ $1F60;commZfifo		; FIFO command storage
(1)   16/     2A2 : =$1F80               zDrvFWrt	equ $1F80;commZWrite		; FIFO command index
(1)   17/     2A2 : =$1F81               zDrvRomBlk	equ $1F81;commZRomBlk		; ROM block flag
(1)   18/     2A2 : =$1F86               zDrvRamSrc	equ $1F82+4;cdRamSrcB		; !! RAM-read source+dest pointers
(1)   19/     2A2 : =$1F87               zDrvRamLen	equ $1F87;cdRamLen		; RAM-read length + flag
(1)   20/     2A2 : =$1F88               zDrvPalMode	equ $1F88;palMode		; PAL speed flag
(1)   21/     2A2 : =$1F89               zDrvMarsBlk	equ $1F89;marsBlock		; Flag to disable 32X's PWM
(1)   22/     2A2 : =$1F8A               zDrvMcdBlk	equ $1F8A;mcdBlock		; Flag to disable SegaCD's PCM
(1)   23/     2A2 : =$20                 zDrvMaxCmnd	equ $20;MAX_ZCMND		; Command fifo size
(1)   24/     2A2 :                     
(1)   25/     2A2 :                     ; ====================================================================
(1)   26/     2A2 :                     ; --------------------------------------------------------
(1)   27/     2A2 :                     ; Labels
(1)   28/     2A2 :                     ; --------------------------------------------------------
(1)   29/     2A2 :                     
(1)   30/     2A2 : =$FFFFFDFF           RAM_ZCdFlagD	equ RAM_ExReserved+$FF			; transferRom flag shared with Z80
(1)   31/     2A2 :                     
(1)   32/     2A2 :                     ; ====================================================================
(1)   33/     2A2 :                     ; --------------------------------------------------------
(1)   34/     2A2 :                     ; Initialize Sound
(1)   35/     2A2 :                     ; --------------------------------------------------------
(1)   36/     2A2 :                     
(1)   37/     2A2 :                     gemaInit:
(1)   38/     2A2 :                     	;!@
(1)   40/     2A2 : 41F9 0000 20CC      		lea	(Z80_CODE).l,a0			; a0 - Z80 code (on $880000)
(1)   41/     2A8 : 303C 1F8B           		move.w	#(Z80_CODE_END-Z80_CODE)-1,d0	; d0 - Size
(1)   42/     2AC : 33FC 0100 00A1      		move.w	#$0100,(z80_bus).l		; Request Z80 stop
              2B2 : 1100             
(1)   43/     2B4 : 33FC 0100 00A1      		move.w	#$0100,(z80_reset).l		; Z80 reset
              2BA : 1200             
(1)   44/     2BC :                     .wait:
(1)   45/     2BC : 0839 0000 00A1      		btst	#0,(z80_bus).l			; Did it stop?
              2C2 : 1100             
