(1) 3755/    1049 :                     	; *** CRITICAL PROCESS ***
(1) 3756/    1049 :                     	;
(1) 3757/    1049 :                     	; pseudo-ref for ldir:
(1) 3758/    1049 :                     	; ld (de),(hl)	; load memory (hl) to (de)
(1) 3759/    1049 :                     	; inc de	; incr de + 1
(1) 3760/    1049 :                     	; inc hl	; incr hl + 1
