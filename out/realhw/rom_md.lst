(1)    7/    4DF6 :                     ; Usage:
(1)    8/    4DF6 :                     ;	data_bank LABEL_START
(1)    9/    4DF6 :                     ;	include "game/data/your_bank.asm"
(1)   10/    4DF6 :                     ;	dend_bank LABEL_END
(1)   11/    4DF6 :                     ;
(1)   12/    4DF6 :                     ; CD/CD32X ONLY:
(1)   13/    4DF6 :                     ; Go to incl_list.asm add an entry in disc_banklist:
(1)   14/    4DF6 :                     ; 	dc.l DATA_BANK			; Label
(1)   15/    4DF6 :                     ; 	dc.b "BNK_EXMP.BIN"		; ISO filename
(1)   16/    4DF6 :                     ;
(1)   17/    4DF6 :                     ; And add the labels and ISO filename at iso_files.asm
(1)   18/    4DF6 :                     ;
(1)   19/    4DF6 :                     ; * This is ONLY required for CD/CD32X, if you forget to
(1)   20/    4DF6 :                     ; include it it will crash the entire system.
(1)   21/    4DF6 :                     ;
(1)   22/    4DF6 :                     ; During your screen code load banks with:
(1)   23/    4DF6 :                     ; 	move.l	#DATA_BANK,d0
(1)   24/    4DF6 :                     ; 	bsr	System_SetDataBank
(1)   25/    4DF6 :                     ;
(1)   26/    4DF6 :                     ; You MUST use the banks for compatibility to all systems
(1)   27/    4DF6 :                     ; even if the standard Genesis doesn't require it.
(1)   28/    4DF6 :                     ; DO note that on SCD and CD32X the DATA banks are stored
(1)   29/    4DF6 :                     ; on DISC so loading banks will be SLOW.
(1)   30/    4DF6 :                     ; ------------------------------------------------------------
(1)   31/    4DF6 :                     
(1)   32/    4DF6 : (MACRO)              	data_bank DATA_BANK0
(1)   32/    4DF6 : =$4DF6               DATA_BANK0 label *                        ; Register label
(1)   32/    4DF6 : =$4DF6               GLBL_MDATA_ST := *                      ; Save current pos globally
(1)   33/    4DF6 :                     	include "game/data/bank_main.asm"
