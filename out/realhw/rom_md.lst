(1)  108/    16CC :                     
(1)  109/       0 :                     pad			struct
(1)  110/       0 :                     id			ds.b 1		; Controller ID
(1)  111/       1 :                     ver			ds.b 1		; Controller type/revision
(1)  112/       2 :                     hold		ds.w 1		; HOLD bits
(1)  113/       4 :                     press		ds.w 1		; PRESSED bits
(1)  114/       6 :                     release		ds.w 1		; RELEASED bits
(1)  115/       8 :                     x			ds.w 1		; Mouse/Pen X speed
(1)  116/       A :                     y			ds.w 1		; Mouse/Pen Y speed
(1)  117/       C :                     page		ds.w 1		; PICO page
(1)  118/       E :                     pageRaw		ds.w 1		; PICO page (raw, all bits)
(1)  119/      10 :                     ext			ds.w 1
(1)  120/      12 :                     port		ds.l 1		;!@ MMIO addr for the controller port
(1)  121/      16 :                     ; pad_len		ds.l 0
(1)  122/    16CC : =$16                 			endstruct
(1)  123/    16CC :                     
(1)  124/    16CC :                     ; ------------------------------------------------
(1)  125/    16CC :                     ; The object's memory
(1)  126/    16CC :                     ; ------------------------------------------------
(1)  127/    16CC :                     
(1)  128/       0 :                     obj			struct
(1)  129/       0 :                     code			ds.l 1		; Object code, If 0 == blank slot
(1)  130/       4 :                     x			ds.l 1		; Object X Position $xxxx.0000
(1)  131/       8 :                     y			ds.l 1		; Object Y Position $yyyy.0000
(1)  132/       C :                     z			ds.l 1		; Object Z Position $zzzz.0000 (3D ONLY)
(1)  133/      10 :                     size_x			ds.w 1		; Object size Left/Right $llrr
(1)  134/      12 :                     size_y			ds.w 1		; Object size Up/Down $uudd
(1)  135/      14 :                     size_z			ds.w 1		; Object size Zback/Zfront $bbff starting from object's X/Y pointer in 10mm's (3D ONLY)
(1)  136/      16 :                     x_spd			ds.w 1		; Object X Speed $xx.00 (object_Speed)
(1)  137/      18 :                     y_spd			ds.w 1		; Object Y Speed $yy.00 ''
(1)  138/      1A :                     z_spd			ds.w 1		; Object Z Speed $zz.00 '' (3D ONLY)
(1)  139/      1C :                     index			ds.b 1		; Object current code index, mostly for init(0) and main(1)
(1)  140/      1D :                     subid			ds.b 1		; Object Sub-ID for custom placement settings
(1)  141/      1E :                     status			ds.b 1		; General purpose USER status: Falling, Floating, etc.
(1)  142/      1F :                     attr			ds.b 1		; Quick attribute bits for VRAM (depending of the type)
(1)  143/      20 :                     					; ** object_Animate ONLY:
(1)  144/      20 :                     frame			ds.w 1		; ** Current frame, object_Animate outputs here
(1)  145/      22 :                     anim_num		ds.w 1		; ** Animation number to use
(1)  146/      24 :                     anim_indx		ds.w 1		; ** Animation script index
(1)  147/      26 :                     anim_icur		ds.b 1		; ** Current animation id
(1)  148/      27 :                     anim_spd		ds.b 1		; ** Animation delay set on animation script
(1)  149/      28 :                     ram			ds.b $40	; Object's own RAM
(1)  150/      68 :                     ; obj_len		ds.l 0
(1)  151/    16CC : =$68                 			endstruct
