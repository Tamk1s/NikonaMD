(1)   56/       0 :                     report		macro text,this,that
(1)   57/       0 :                     	if MOMPASS == 2
(1)   58/       0 :                     		if that == -1
(1)   59/       0 :                     			message text+": \{(this)&$FFFFFF}"
(1)   60/       0 :                     		else
(1)   61/       0 :                     			if this > that
(1)   62/       0 :                     				warning "RAN OUT OF "+text+" SPACE (\{(this)&$FFFFFF} of \{(that)&$FFFFFF})"
(1)   63/       0 :                     			else
(1)   64/       0 :                     				message text+" uses \{(this)&$FFFFFF} of \{(that)&$FFFFFF}"
(1)   65/       0 :                     			endif
