(1)  247/    15FE :                     ; --------------------------------------------------------
(1)  248/    15FE :                     ; System_Render
(1)  249/    15FE :                     ;
(1)  250/    15FE :                     ; This will:
(1)  251/    15FE :                     ; - Drop a frame if we got late on VBlank
(1)  252/    15FE :                     ; - Process Palette fading buffers
(1)  253/    15FE :                     ;   (Video_MdMars_RunFade: CPU-INTENSIVE IF PROCESSING
(1)  254/    15FE :                     ;   BOTH VDP AND 32X SVDP Palettes)
(1)  255/    15FE :                     ; - Check the sound driver for any changes/requests
(1)  256/    15FE :                     ;   from Z80 (Sound_Update, several times)
(1)  257/    15FE :                     ; - 32X/CD32X only: Update the "DREQ RAM" section
(1)  258/    15FE :                     ;   to the SH2 using DREQ FIFO (System_MdMars_Update)
(1)  259/    15FE :                     ;
(1)  260/    15FE :                     ; Then during VBlank:
(1)  261/    15FE :                     ; - Read the Input data (System_Input)
(1)  262/    15FE :                     ; - Transfer the VDP Palette, Sprites and Scroll
(1)  263/    15FE :                     ;   from from RAM to VDP and process the DMA BLAST list.
(1)  264/    15FE :                     ;   (Video_Render)
(1)  265/    15FE :                     ;
(1)  266/    15FE :                     ; Notes:
(1)  267/    15FE :                     ; - This exits INSIDE VBlank
(1)  268/    15FE :                     ; - If VDP Display is disabled all of this
(1)  269/    15FE :                     ;   will be skipped.
(1)  270/    15FE :                     ; --------------------------------------------------------
(1)  271/    15FE :                     
(1)  272/    15FE :                     System_Render:
(1)  273/    15FE : 3E38 F0F2           		move.w	(RAM_VdpRegSet1).w,d7
(1)  274/    1602 : 0807 0006           		btst	#bitDispEnbl,d7
(1)  275/    1606 : 671C                		beq	.forgot_disp
(1)  276/    1608 : 6100 F81A           		bsr	Video_RunFade			; Process VDP palette fade
(1)  277/    160C :                     .wait_early:
(1)  278/    160C : 613E                		bsr	Sound_Update			; Update sound on wait
(1)  279/    160E : 3E39 00C0 0004      		move.w	(vdp_ctrl).l,d7
(1)  280/    1614 : 0807 0003           		btst	#bitVBlk,d7
(1)  281/    1618 : 66F2                		bne.s	.wait_early
