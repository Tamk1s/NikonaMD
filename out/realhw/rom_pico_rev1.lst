(1) 2142/    123A :                     ; Video_PrintVal, Video_PrintValW
(1) 2143/    123A :                     ;
(1) 2144/    123A :                     ; Prints a memory value
(1) 2145/    123A :                     ;
(1) 2146/    123A :                     ; Input:
(1) 2147/    123A :                     ; a0   | Memory location to read
(1) 2148/    123A :                     ; a1   | Type:
(1) 2149/    123A :                     ;        	0 - Byte
(1) 2150/    123A :                     ;        	1 - Word
(1) 2151/    123A :                     ;        	2 - Longword but as a 24-bit address
(1) 2152/    123A :                     ;        	3 - Full Longword
(1) 2153/    123A :                     ;
(1) 2154/    123A :                     ; d0.w | X position
(1) 2155/    123A :                     ; d1.w | Y position
(1) 2156/    123A :                     ; d2.w | Font VRAM location
