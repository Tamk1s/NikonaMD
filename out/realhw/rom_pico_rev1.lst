(1)    7/    4CFC :                     ; Usage:
(1)    8/    4CFC :                     ;	data_bank LABEL_START
(1)    9/    4CFC :                     ;	include "game/data/your_bank.asm"
(1)   10/    4CFC :                     ;	dend_bank LABEL_END
(1)   11/    4CFC :                     ;
(1)   12/    4CFC :                     ; CD/CD32X ONLY:
(1)   13/    4CFC :                     ; Go to incl_list.asm add an entry in disc_banklist:
(1)   14/    4CFC :                     ; 	dc.l DATA_BANK			; Label
(1)   15/    4CFC :                     ; 	dc.b "BNK_EXMP.BIN"		; ISO filename
(1)   16/    4CFC :                     ;
(1)   17/    4CFC :                     ; And add the labels and ISO filename at iso_files.asm
(1)   18/    4CFC :                     ;
(1)   19/    4CFC :                     ; * This is ONLY required for CD/CD32X, if you forget to
(1)   20/    4CFC :                     ; include it it will crash the entire system.
(1)   21/    4CFC :                     ;
(1)   22/    4CFC :                     ; During your screen code load banks with:
(1)   23/    4CFC :                     ; 	move.l	#DATA_BANK,d0
(1)   24/    4CFC :                     ; 	bsr	System_SetDataBank
(1)   25/    4CFC :                     ;
(1)   26/    4CFC :                     ; You MUST use the banks for compatibility to all systems
(1)   27/    4CFC :                     ; even if the standard Genesis doesn't require it.
(1)   28/    4CFC :                     ; DO note that on SCD and CD32X the DATA banks are stored
(1)   29/    4CFC :                     ; on DISC so loading banks will be SLOW.
(1)   30/    4CFC :                     ; ------------------------------------------------------------
(1)   31/    4CFC :                     
(1)   32/    4CFC : (MACRO)              	data_bank DATA_BANK0
(1)   32/    4CFC : =$4CFC               DATA_BANK0 label *                        ; Register label
(1)   32/    4CFC : =$4CFC               GLBL_MDATA_ST := *                      ; Save current pos globally
(1)   33/    4CFC :                     	include "game/data/bank_main.asm"
