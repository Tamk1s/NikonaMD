(1)   56/     27A :                     ; gemaTrk - Sequence entry in the current master
(1)   57/     27A :                     ;           list
(1)   58/     27A :                     ;
(1)   59/     27A :                     ; enblt | Disable/Enable global beats on this Sequence:
(1)   60/     27A :                     ;         0 - Don't use beats
(1)   61/     27A :                     ;         1 - Use beats
(1)   62/     27A :                     ; ticks | Ticks (Default tempo: 150-NTSC 120-PAL)
(1)   63/     27A :                     ;   loc | Direct 24-bit location of the sequence data
(1)   64/     27A :                     ; ----------------------------------------------------
(1)   65/     27A :                     
(1)   66/     27A :                     gemaTrk macro enblt,ticks,loc
(1)   67/     27A :                     	dc.l ((enblt&$01)<<31)|((ticks&$7F)<<24)|(loc&$FFFFFF)
(1)   68/     27A :                     	endm
