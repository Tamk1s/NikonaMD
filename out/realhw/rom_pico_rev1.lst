(1) 2159/    123A :                     ;
(1) 2160/    123A :                     ; * Font VRAM location
(1) 2161/    123A :                     ; Default 8x8:  DEF_PrintVram
(1) 2162/    123A :                     ; Default 8x16: DEF_PrintVramW
(1) 2163/    123A :                     ;
(1) 2164/    123A :                     ; * Screen VRAM
(1) 2165/    123A :                     ; Foreground: DEF_VRAM_FG
(1) 2166/    123A :                     ; Background: DEF_VRAM_BG
(1) 2167/    123A :                     ; Window:     DEF_VRAM_WD
(1) 2168/    123A :                     ;
(1) 2169/    123A :                     ; * Screen Width
