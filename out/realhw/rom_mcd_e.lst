(1) 3670/    1114 : E5                  		push	hl
(1) 3671/    1115 : 79                  		ld	a,c			; len - LSB
(1) 3672/    1116 : 95                  		sub	a,l
(1) 3673/    1117 : 4F                  		ld	c,a			; Save new size
(1) 3674/    1118 : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore TOP
(1) 3675/    111B : CD 55 11            		call	.transfer
(1) 3676/    111E : E1                  		pop	hl			; Restore len and midlow address
(1) 3677/    111F : C1                  		pop	bc
(1) 3678/    1120 : 4D                  		ld	c,l			; Get second len
(1) 3679/    1121 : 0C                  		inc	c
(1) 3680/    1122 : 3A 36 00            		ld	a,(x68ksrcmid)
(1) 3681/    1125 : E6 80               		and	80h
(1) 3682/    1127 : C6 80               		add	a,80h
