(1) 3755/    1173 :                     	; *** CRITICAL PROCESS ***
(1) 3756/    1173 :                     	;
(1) 3757/    1173 :                     	; pseudo-ref for ldir:
(1) 3758/    1173 :                     	; ld (de),(hl)	; load memory (hl) to (de)
(1) 3759/    1173 :                     	; inc de	; incr de + 1
(1) 3760/    1173 :                     	; inc hl	; incr hl + 1
(1) 3761/    1173 :                     	; dec bc	; decr bc - 1
