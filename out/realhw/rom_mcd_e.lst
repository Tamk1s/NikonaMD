(2)  320/    6146 :                     ;
(2)  321/    6146 :                     ; Returns:
(2)  322/    6146 :                     ; mcd_comm_s  | %--ep----
(2)  323/    6146 :                     ;               p - SUB-CPU reports that data passed
(2)  324/    6146 :                     ;               e - Flag: 0 - Found file
(2)  325/    6146 :                     ;                         1 - File NOT found
(2)  326/    6146 :                     ; mcd_dcomm_s | $00-$10
(2)  327/    6146 :                     ;               Current data packet.
