(1) 3652/    10F8 : CF                  		rst	8
(1) 3653/    10F9 : 22 35 00            		ld	(x68ksrclsb),hl		; Backup midlow address
(1) 3654/    10FC : CB BC               		res	7,h			; Reset MSB bit 7
(1) 3655/    10FE : 06 00               		ld	b,0			; Clear b
(1) 3656/    1100 : 0B                  		dec	bc			; len-1
(1) 3657/    1101 : 09                  		add	hl,bc			; Add len to the mid and low to this temp address
(1) 3658/    1102 : CB 7C               		bit	7,h			; Did it cross the bank?
(1) 3659/    1104 : 20 0B               		jr	nz,.double		; Then it's a double transfer
(1) 3660/    1106 : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore hl
(1) 3661/    1109 : 0C                  		inc	c			; len+1
(1) 3662/    110A : 47                  		ld	b,a			; b - $xx0000
(1) 3663/    110B : CD 55 11            		call	.transfer
(1) 3664/    110E : DD E1               		pop	ix
(1) 3665/    1110 : C9                  		ret
(1) 3666/    1111 :                     .double:
