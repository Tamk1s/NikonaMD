(1)  248/FFFFFFFFFFFF194C :                     ; --------------------------------------------------------
(1)  249/FFFFFFFFFFFF194C :                     ; System_Render
(1)  250/FFFFFFFFFFFF194C :                     ;
(1)  251/FFFFFFFFFFFF194C :                     ; This will:
(1)  252/FFFFFFFFFFFF194C :                     ; - Drop a frame if we got late on VBlank
(1)  253/FFFFFFFFFFFF194C :                     ; - Process Palette fading buffers
(1)  254/FFFFFFFFFFFF194C :                     ;   (Video_MdMars_RunFade: CPU-INTENSIVE IF PROCESSING
(1)  255/FFFFFFFFFFFF194C :                     ;   BOTH VDP AND 32X SVDP Palettes)
(1)  256/FFFFFFFFFFFF194C :                     ; - Check the sound driver for any changes/requests
(1)  257/FFFFFFFFFFFF194C :                     ;   from Z80 (Sound_Update, several times)
(1)  258/FFFFFFFFFFFF194C :                     ; - 32X/CD32X only: Update the "DREQ RAM" section
(1)  259/FFFFFFFFFFFF194C :                     ;   to the SH2 using DREQ FIFO (System_MdMars_Update)
(1)  260/FFFFFFFFFFFF194C :                     ;
(1)  261/FFFFFFFFFFFF194C :                     ; Then during VBlank:
(1)  262/FFFFFFFFFFFF194C :                     ; - Read the Input data (System_Input)
(1)  263/FFFFFFFFFFFF194C :                     ; - Transfer the VDP Palette, Sprites and Scroll
(1)  264/FFFFFFFFFFFF194C :                     ;   from from RAM to VDP and process the DMA BLAST list.
(1)  265/FFFFFFFFFFFF194C :                     ;   (Video_Render)
(1)  266/FFFFFFFFFFFF194C :                     ;
(1)  267/FFFFFFFFFFFF194C :                     ; Notes:
(1)  268/FFFFFFFFFFFF194C :                     ; - This exits INSIDE VBlank
(1)  269/FFFFFFFFFFFF194C :                     ; - If VDP Display is disabled all of this
(1)  270/FFFFFFFFFFFF194C :                     ;   will be skipped.
(1)  271/FFFFFFFFFFFF194C :                     ; --------------------------------------------------------
(1)  272/FFFFFFFFFFFF194C :                     
