(1) 3628/    10EE :                     ; readRom
(1) 3629/    10EE :                     ;
(1) 3630/    10EE :                     ; Transfer bytes from ROM to Z80 RAM.
(1) 3631/    10EE :                     ; This also tells to 68k that we want to access ROM
(1) 3632/    10EE :                     ;
(1) 3633/    10EE :                     ; Input:
(1) 3634/    10EE :                     ; a  | 68K Address $xx0000
(1) 3635/    10EE :                     ;  c | Byte count (size 0 NOT allowed, MAX: 0FFh)
(1) 3636/    10EE :                     ; hl | 68K Address $00xxxx
(1) 3637/    10EE :                     ; de | Destination pointer
(1) 3638/    10EE :                     ;
(1) 3639/    10EE :                     ; Uses:
(1) 3640/    10EE :                     ; b
(1) 3641/    10EE :                     ;
(1) 3642/    10EE :                     ; Notes:
(1) 3643/    10EE :                     ; call RST 20h first, so the currenty playing DAC
(1) 3644/    10EE :                     ; sample has enough data before getting busy here.
(1) 3645/    10EE :                     ; --------------------------------------------------------
(1) 3646/    10EE :                     
(1) 3647/    10EE :                     readRom:
