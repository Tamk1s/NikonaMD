(1) 3780/    1190 : 4F                  		ld	c,a
(1) 3781/    1191 : DD CB 00 46         		bit	0,(ix)		; Genesis blocks ROM?
(1) 3782/    1195 : C4 9C 11            		call	nz,.x68klpwt
(1) 3783/    1198 : ED B0               		ldir
(1) 3784/    119A : CF                  		rst	8
(1) 3785/    119B : C9                  		ret
