(1)  276/FFFFFFFFFFFF1954 : 671C                		beq	.forgot_disp
(1)  277/FFFFFFFFFFFF1956 : 6100 F3C8           		bsr	Video_RunFade			; Process VDP palette fade
(1)  278/FFFFFFFFFFFF195A :                     .wait_early:
(1)  279/FFFFFFFFFFFF195A : 613E                		bsr	Sound_Update			; Update sound on wait
