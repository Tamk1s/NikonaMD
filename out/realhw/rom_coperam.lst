(1)  136/     298 : 4238 FDFF           		clr.b	(RAM_ZCdFlagD).w		; Clear flag here
(1)  137/     29C : 48E7 070E           		movem.l	a4-a6/d5-d7,-(sp)
(1)  138/     2A0 : 61EC                		bsr	sndLockZ80
(1)  139/     2A2 : 7E00                		moveq	#0,d7
(1)  140/     2A4 : 1E39 00A0 1F87      		move.b	(z80_cpu+zDrvRamLen).l,d7	; Len == 0?
(1)  141/     2AA : 6732                		beq.s	.no_size			; Invalid size, do nothing
(1)  142/     2AC : 5347                		subq.w	#1,d7				; dbf -1
(1)  143/     2AE : 4DF9 00A0 1F87      		lea	(z80_cpu+(zDrvRamSrc+1)),a6	; a6 - SRC location and DST, backwards
(1)  144/     2B4 : 4BF9 00A0 0000      		lea	(z80_cpu),a5			; a5 - Z80 area
(1)  145/     2BA : 1C26                		move.b	-(a6),d6			; d6 - Source in 68K area
(1)  146/     2BC : 4846                		swap	d6
(1)  147/     2BE : 1C26                		move.b	-(a6),d6
(1)  148/     2C0 : E14E                		lsl.w	#8,d6
(1)  149/     2C2 : 1C26                		move.b	-(a6),d6
(1)  150/     2C4 : 7A00                		moveq	#0,d5
(1)  151/     2C6 : 1A26                		move.b	-(a6),d5			; d5 - Destination in Z80 area
(1)  152/     2C8 : E14D                		lsl.w	#8,d5
(1)  153/     2CA : 1A26                		move.b	-(a6),d5
(1)  154/     2CC : DBC5                		add.l	d5,a5				; Add base to destination
(1)  155/     2CE : 2846                		move.l	d6,a4
