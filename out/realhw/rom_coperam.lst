(1)    7/    4D90 :                     ; Usage:
(1)    8/    4D90 :                     ;	data_bank LABEL_START
(1)    9/    4D90 :                     ;	include "game/data/your_bank.asm"
(1)   10/    4D90 :                     ;	dend_bank LABEL_END
(1)   11/    4D90 :                     ;
(1)   12/    4D90 :                     ; CD/CD32X ONLY:
(1)   13/    4D90 :                     ; Go to incl_list.asm add an entry in disc_banklist:
(1)   14/    4D90 :                     ; 	dc.l DATA_BANK			; Label
(1)   15/    4D90 :                     ; 	dc.b "BNK_EXMP.BIN"		; ISO filename
(1)   16/    4D90 :                     ;
(1)   17/    4D90 :                     ; And add the labels and ISO filename at iso_files.asm
(1)   18/    4D90 :                     ;
(1)   19/    4D90 :                     ; * This is ONLY required for CD/CD32X, if you forget to
(1)   20/    4D90 :                     ; include it it will crash the entire system.
(1)   21/    4D90 :                     ;
(1)   22/    4D90 :                     ; During your screen code load banks with:
(1)   23/    4D90 :                     ; 	move.l	#DATA_BANK,d0
(1)   24/    4D90 :                     ; 	bsr	System_SetDataBank
(1)   25/    4D90 :                     ;
(1)   26/    4D90 :                     ; You MUST use the banks for compatibility to all systems
(1)   27/    4D90 :                     ; even if the standard Genesis doesn't require it.
(1)   28/    4D90 :                     ; DO note that on SCD and CD32X the DATA banks are stored
(1)   29/    4D90 :                     ; on DISC so loading banks will be SLOW.
(1)   30/    4D90 :                     ; ------------------------------------------------------------
(1)   31/    4D90 :                     
(1)   32/    4D90 : (MACRO)              	data_bank DATA_BANK0
