(1) 3670/     FEA : E5                  		push	hl
(1) 3671/     FEB : 79                  		ld	a,c			; len - LSB
(1) 3672/     FEC : 95                  		sub	a,l
(1) 3673/     FED : 4F                  		ld	c,a			; Save new size
(1) 3674/     FEE : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore TOP
(1) 3675/     FF1 : CD 2B 10            		call	.transfer
(1) 3676/     FF4 : E1                  		pop	hl			; Restore len and midlow address
(1) 3677/     FF5 : C1                  		pop	bc
