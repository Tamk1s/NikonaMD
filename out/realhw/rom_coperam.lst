(1)   56/     27A :                     ; gemaTrk - Sequence entry in the current master
(1)   57/     27A :                     ;           list
(1)   58/     27A :                     ;
(1)   59/     27A :                     ; enblt | Disable/Enable global beats on this Sequence:
(1)   60/     27A :                     ;         0 - Don't use beats
(1)   61/     27A :                     ;         1 - Use beats
(1)   62/     27A :                     ; ticks | Ticks (Default tempo: 150-NTSC 120-PAL)
(1)   63/     27A :                     ;   loc | Direct 24-bit location of the sequence data
(1)   64/     27A :                     ; ----------------------------------------------------
(1)   65/     27A :                     
(1)   66/     27A :                     gemaTrk macro enblt,ticks,loc
(1)   67/     27A :                     	dc.l ((enblt&$01)<<31)|((ticks&$7F)<<24)|(loc&$FFFFFF)
(1)   68/     27A :                     	endm
(1)   69/     27A :                     
(1)   70/     27A :                     ; ----------------------------------------------------
(1)   71/     27A :                     ; gemaHead - Sequence data header
(1)   72/     27A :                     ;
(1)   73/     27A :                     ; blk_data  | Block data pointer
(1)   74/     27A :                     ; patt_data | Pattern data pointer
(1)   75/     27A :                     ; ins_list  | instrument list pointer
(1)   76/     27A :                     ; num_chnls | Number of channels used in the seq
(1)   77/     27A :                     ;             If 0: Read ALL channels
(1)   78/     27A :                     ;                   (NOT recommended, UNSTABLE)
(1)   79/     27A :                     ;
(1)   80/     27A :                     ; Note:
(1)   81/     27A :                     ; Pointers are in 68k map area
(1)   82/     27A :                     ; ----------------------------------------------------
(1)   83/     27A :                     
(1)   84/     27A :                     gemaHead macro blk,pat,ins,num
