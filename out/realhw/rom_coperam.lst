(1)  103/     27A :                     ; You MUST use this on unused instruments.
(1)  104/     27A :                     ; ----------------------------------------------------
(1)  105/     27A :                     
(1)  106/     27A :                     gInsNull macro
(1)  107/     27A :                     	dc.b $00,$00,$00,$00
(1)  108/     27A :                     	dc.b $00,$00,$00,$00
(1)  109/     27A :                     	endm
(1)  110/     27A :                     
(1)  111/     27A :                     ; ----------------------------------------------------
(1)  112/     27A :                     ; gInsPsg - PSG tone
(1)  113/     27A :                     ;
(1)  114/     27A :                     ; pitch | Pitch/Octave
(1)  115/     27A :                     ; alv   | Attack level
(1)  116/     27A :                     ; atk   | Attack rate
(1)  117/     27A :                     ; slv   | Sustain
(1)  118/     27A :                     ; dky   | Decay rate (up)
(1)  119/     27A :                     ; rrt   | Release rate (down)
(1)  120/     27A :                     ; vib   | Set to 0, reserved for vibrato
(1)  121/     27A :                     ; ----------------------------------------------------
(1)  122/     27A :                     
(1)  123/     27A :                     gInsPsg	macro pitch,alv,atk,slv,dky,rrt,vib
(1)  124/     27A :                     	dc.b $80,pitch,alv,atk
(1)  125/     27A :                     	dc.b slv,dky,rrt,vib
(1)  126/     27A :                     	endm
(1)  127/     27A :                     
(1)  128/     27A :                     ; ----------------------------------------------------
(1)  129/     27A :                     ; gInsPsg - PSG noise
(1)  130/     27A :                     ;
(1)  131/     27A :                     ; pitch | Pitch/Octave
(1)  132/     27A :                     ; alv   | Attack level
(1)  133/     27A :                     ; atk   | Attack rate
(1)  134/     27A :                     ; slv   | Sustain
(1)  135/     27A :                     ; dky   | Decay rate (up)
(1)  136/     27A :                     ; rrt   | Release rate (down)
(1)  137/     27A :                     ; vib   | Set to 0, reserved for vibrato
(1)  138/     27A :                     ; mode  | Noise mode: %tmm
(1)  139/     27A :                     ;         t - Bass(0)|Noise(1)
(1)  140/     27A :                     ;         m - Clock(00)|Clock/2(01)|Clock/4(10)|Tone3(11)
(1)  141/     27A :                     ;
(1)  142/     27A :                     ; Note:
(1)  143/     27A :                     ; Using Tone3 will turn OFF channel 3.
(1)  144/     27A :                     ; ----------------------------------------------------
(1)  145/     27A :                     
(1)  146/     27A :                     gInsPsgN macro pitch,alv,atk,slv,dky,rrt,vib,mode
(1)  147/     27A :                     	dc.b $90|mode,pitch,alv,atk
(1)  148/     27A :                     	dc.b slv,dky,rrt,vib
(1)  149/     27A :                     	endm
(1)  150/     27A :                     
(1)  151/     27A :                     ; ----------------------------------------------------
(1)  152/     27A :                     ; gInsFm - YM2612 FM normal instrument/patch
(1)  153/     27A :                     ;
(1)  154/     27A :                     ; pitch | Pitch/Octave
(1)  155/     27A :                     ; fmins | 24-bit pointer to FM patch data
(1)  156/     27A :                     ; ----------------------------------------------------
(1)  157/     27A :                     
(1)  158/     27A :                     gInsFm macro pitch,fmins
(1)  159/     27A :                     	dc.b $A0,pitch,((fmins>>16)&$FF),((fmins>>8)&$FF)
(1)  160/     27A :                     	dc.b fmins&$FF,$00,$00,$00
(1)  161/     27A :                     	endm
(1)  162/     27A :                     
(1)  163/     27A :                     ; ----------------------------------------------------
(1)  164/     27A :                     ; gInsFm - YM2612 FM special instrument/patch
(1)  165/     27A :                     ;
(1)  166/     27A :                     ; pitch | UNUSED, value ignored (set to 0)
(1)  167/     27A :                     ; fmins | 24-bit pointer to FM patch data
(1)  168/     27A :                     ; ----------------------------------------------------
(1)  169/     27A :                     
(1)  170/     27A :                     gInsFm3	macro pitch,fmins
(1)  171/     27A :                     	dc.b $B0,pitch,((fmins>>16)&$FF),((fmins>>8)&$FF)
(1)  172/     27A :                     	dc.b fmins&$FF,$00,$00,$00
(1)  173/     27A :                     	endm
(1)  174/     27A :                     
(1)  175/     27A :                     ; ----------------------------------------------------
(1)  176/     27A :                     ; gInsDac - DAC instrument
(1)  177/     27A :                     ;
(1)  178/     27A :                     ; pitch | Pitch/Octave
(1)  179/     27A :                     ; start | 24-bit pointer
(1)  180/     27A :                     ; flags | Flags: %0000000l
(1)  181/     27A :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  182/     27A :                     ; ----------------------------------------------------
(1)  183/     27A :                     
(1)  184/     27A :                     gInsDac	macro pitch,start,flags
(1)  185/     27A :                     	dc.b $C0|flags,pitch,((start>>16)&$FF),((start>>8)&$FF)
(1)  186/     27A :                     	dc.b start&$FF,0,0,0
(1)  187/     27A :                     	endm
(1)  188/     27A :                     
(1)  189/     27A :                     ; ----------------------------------------------------
(1)  190/     27A :                     ; gInsPcm - RF5C164 PCM Sample (SEGA CD)
(1)  191/     27A :                     ;
(1)  192/     27A :                     ; pitch | Pitch/Octave
(1)  193/     27A :                     ; start | 24-bit direct pointer to
(1)  194/     27A :                     ;         Sub-CPU's memory area.
(1)  195/     27A :                     ; flags | Flags: %0000000l
(1)  196/     27A :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  197/     27A :                     ; ----------------------------------------------------
(1)  198/     27A :                     
(1)  199/     27A :                     gInsPcm	macro pitch,start,flags
(1)  200/     27A :                      if MCD|MARSCD
(1)  201/     27A :                     	dc.b $D0|flags,pitch,((start>>16)&$FF),((start>>8)&$FF)
(1)  202/     27A :                     	dc.b start&$FF,0,0,0
(1)  203/     27A :                      else
(1)  204/     27A :                     	dc.b $00,$00,$00,$00
(1)  205/     27A :                     	dc.b $00,$00,$00,$00
(1)  206/     27A :                      endif
(1)  207/     27A :                     	endm
(1)  208/     27A :                     
(1)  209/     27A :                     ; ----------------------------------------------------
(1)  210/     27A :                     ; gInsPwm - PWM Sample (SEGA 32X)
(1)  211/     27A :                     ;
(1)  212/     27A :                     ; pitch | Pitch/Octave
(1)  213/     27A :                     ; start | 32-bit pointer to
(1)  214/     27A :                     ;         SH2's map view: CS1(ROM) or CS3(SDRAM)
(1)  215/     27A :                     ; flags | Flags: %000000sl
(1)  216/     27A :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  217/     27A :                     ;         | s - Sample data is in Stereo: No(0)/Yes(1)
(1)  218/     27A :                     ; ----------------------------------------------------
(1)  219/     27A :                     
(1)  220/     27A :                     gInsPwm	macro pitch,start,flags
(1)  221/     27A :                      if MARS|MARSCD
(1)  222/     27A :                     	dc.b $E0|flags,pitch,((start>>24)&$FF),((start>>16)&$FF)
(1)  223/     27A :                     	dc.b ((start>>8)&$FF),start&$FF,0,0
(1)  224/     27A :                      else
(1)  225/     27A :                     	dc.b $00,$00,$00,$00
(1)  226/     27A :                     	dc.b $00,$00,$00,$00
(1)  227/     27A :                      endif
(1)  228/     27A :                     	endm
(1)  229/     27A :                     	
(1)  230/     27A :                     ; ----------------------------------------------------
(1)  231/     27A :                     ; !@ gInsPco - Pico ADPCM instrument
(1)  232/     27A :                     ;
(1)  233/     27A :                     ; pitch | Pitch/Octave
(1)  234/     27A :                     ; start | 24-bit pointer
(1)  235/     27A :                     ; flags | Flags: %0000fffl
(1)  236/     27A :                     ;         | l - Enable loop: No(0)/Yes(1)
(1)  237/     27A :                     ;         | f - ADPCM filter bit select: 
(1)  238/     27A :                     ;				00 = ??
(1)  239/     27A :                     ;				01 = 6 kHz, 
(1)  240/     27A :                     ;				10 = 12 kHz,
(1)  241/     27A :                     ;				11 = 16 kHz, 
(1)  242/     27A :                     ; volume | volume: %00000vvv
(1)  243/     27A :                     ;         | v - Volume strength
(1)  244/     27A :                     ; ----------------------------------------------------
(1)  245/     27A :                     gInsPco	macro pitch,start,flags,volume
(1)  246/     27A :                      if PICO == 1
(1)  247/     27A :                     	dc.b $F0|flags,pitch,((start>>16)&$FF),((start>>8)&$FF)
(1)  248/     27A :                     	dc.b start&$FF,volume,0,0
(1)  249/     27A :                      else
(1)  250/     27A :                      	dc.b $00,$00,$00,$00
(1)  251/     27A :                     	dc.b $00,$00,$00,$00
(1)  252/     27A :                      endif
(1)  253/     27A :                     	endm
