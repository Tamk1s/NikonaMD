(1) 3632/     FC4 :                     ;
(1) 3633/     FC4 :                     ; Input:
(1) 3634/     FC4 :                     ; a  | 68K Address $xx0000
(1) 3635/     FC4 :                     ;  c | Byte count (size 0 NOT allowed, MAX: 0FFh)
(1) 3636/     FC4 :                     ; hl | 68K Address $00xxxx
(1) 3637/     FC4 :                     ; de | Destination pointer
(1) 3638/     FC4 :                     ;
(1) 3639/     FC4 :                     ; Uses:
(1) 3640/     FC4 :                     ; b
(1) 3641/     FC4 :                     ;
(1) 3642/     FC4 :                     ; Notes:
(1) 3643/     FC4 :                     ; call RST 20h first, so the currenty playing DAC
(1) 3644/     FC4 :                     ; sample has enough data before getting busy here.
(1) 3645/     FC4 :                     ; --------------------------------------------------------
(1) 3646/     FC4 :                     
(1) 3647/     FC4 :                     readRom:
