(1)  146/       8 :                     ;
(1)  147/       8 :                     ; Writes wave data to DAC using data stored
(1)  148/       8 :                     ; on the wave buffer, call this routine every 6 or 8
(1)  149/       8 :                     ; instructions to keep the samplerate stable.
(1)  150/       8 :                     ;
(1)  151/       8 :                     ; Input (EXX):
(1)  152/       8 :                     ;  c - WAVE buffer MSB
(1)  153/       8 :                     ; de - Pitch (xx.00)
(1)  154/       8 :                     ; h  - WAVE buffer LSB (as xx.00)
(1)  155/       8 :                     ;
(1)  156/       8 :                     ; Uses (EXX):
(1)  157/       8 :                     ; b
(1)  158/       8 :                     ;
(1)  159/       8 :                     ; Notes:
(1)  160/       8 :                     ; ONLY USE dac_on and dac_off to turn OFF/ON
(1)  161/       8 :                     ; DAC playback
(1)  162/       8 :                     ;
(1)  163/       8 :                     ; Samplerate is 16000hz with minimal quality loss.
(1)  164/       8 :                     ; --------------------------------------------------------
(1)  165/       8 :                     
(1)  166/       8 :                     ; EXX set:
(1)  167/       8 :                     ; af - temporal
(1)  168/       8 :                     ; bc - l temporal | dWaveBuff MSB
(1)  169/       8 :                     ; de - pitch increment
(1)  170/       8 :                     ; hl - wave buffer position 00.00h
(1)  171/       8 :                     		org 8
(1)  172/       8 : D9                  dac_me:		exx			; * flip registers | Changes between EXX(play) and RET(stop)
