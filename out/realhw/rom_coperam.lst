(1) 3652/     FCE : CF                  		rst	8
(1) 3653/     FCF : 22 35 00            		ld	(x68ksrclsb),hl		; Backup midlow address
(1) 3654/     FD2 : CB BC               		res	7,h			; Reset MSB bit 7
(1) 3655/     FD4 : 06 00               		ld	b,0			; Clear b
(1) 3656/     FD6 : 0B                  		dec	bc			; len-1
(1) 3657/     FD7 : 09                  		add	hl,bc			; Add len to the mid and low to this temp address
(1) 3658/     FD8 : CB 7C               		bit	7,h			; Did it cross the bank?
(1) 3659/     FDA : 20 0B               		jr	nz,.double		; Then it's a double transfer
(1) 3660/     FDC : 2A 35 00            		ld	hl,(x68ksrclsb)		; Restore hl
(1) 3661/     FDF : 0C                  		inc	c			; len+1
(1) 3662/     FE0 : 47                  		ld	b,a			; b - $xx0000
(1) 3663/     FE1 : CD 2B 10            		call	.transfer
