(1)  175/       B : 6C                  		ld	l,h		;
(1)  176/       C : 61                  		ld	h,c		; h - Set buffer MSB
(1)  177/       D : 3E 2A               		ld	a,2Ah		;
(1)  178/       F : 32 00 40            		ld	(Zym_ctrl_1),a	; Set YM Register 2Ah
(1)  179/      12 : 7E                  		ld	a,(hl)		; Read wave byte and
(1)  180/      13 : 32 01 40            		ld	(Zym_data_1),a	; write it to DAC
