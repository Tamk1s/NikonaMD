(1)  117/     292 :                     ; gemaSendRam
(1)  118/     292 :                     ;
(1)  119/     292 :                     ; If you are reading data from 68000's RAM you MUST call
(1)  120/     292 :                     ; this a lot during display, commonly during the VBlank waiting
(1)  121/     292 :                     ; loop.
(1)  122/     292 :                     ;
(1)  123/     292 :                     ; This checks if the Z80 wants to read from RAM, then here
(1)  124/     292 :                     ; we manually write the bytes to the Z80
(1)  125/     292 :                     ;
(1)  126/     292 :                     ; SCD/CD32X:
(1)  127/     292 :                     ; - DAC samples are safe to read from WORD-RAM, but NOT
(1)  128/     292 :                     ;   when Stamps are being used, use PCM samples instead.
(1)  129/     292 :                     ; - Be careful when loading new data with gemaSetMasterList to
(1)  130/     292 :                     ;   WORD-RAM, make sure MAIN-CPU has the permission set.
(1)  131/     292 :                     ; ----------------------------------------------------------------
(1)  132/     292 :                     
(1)  133/     292 :                     gemaSendRam:
(1)  134/     292 : 4A38 FDFF           		tst.b	(RAM_ZCdFlagD).w		; Z80 WROTE the flag?
